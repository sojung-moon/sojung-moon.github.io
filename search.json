---
layout: null
---
[
{%- for p in site.posts -%}
  {%- capture th -%}{% include thumb.html post=p %}{%- endcapture -%}
  {
    "title": {{ p.title | jsonify }},
    "original": {{ p.original_title | default: "" | jsonify }},
    "category": {{ p.categories | first | jsonify }},
    "tags": {{ p.tags | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "thumb": {{ th | strip | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
